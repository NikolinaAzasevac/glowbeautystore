rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          currentUserDoc().data.role == 'admin'
          || currentUserDoc().data.isAdmin == true
        );
    }

    function userDoesNotChangeAdminFields() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'isAdmin']);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'role'])
        && request.resource.data.userId == userId
        && request.resource.data.role == 'user'
        && (
          !request.resource.data.keys().hasAny(['isAdmin'])
          || request.resource.data.isAdmin == false
        );

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && userDoesNotChangeAdminFields()
        );

      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
